# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key
# Enables interactive maps, customer geolocation, route planning, and address searching.
VITE_GOOGLE_MAPS_API_KEY=

# ==========================================
# CONFIGURACIÓN DE SUPABASE (NUBE Y TIEMPO REAL)
# ==========================================
# VITE_SUPABASE_URL: URL del proyecto Supabase (ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Llave pública anónima de la API de Supabase (anon public key)
VITE_SUPABASE_ANON_KEY=

# ==========================================
# CONFIGURACIÓN DE RESPALDOS - IMPERIO PRO
# ==========================================
# Directorio base para almacenamiento de respaldos en el servidor/sistema
BACKUP_STORAGE_PATH=/var/www/imperiopro/storage/backups

# Subrutas específicas según el tipo de respaldo
BACKUP_PATH_DATABASE=/var/www/imperiopro/storage/backups/db/
BACKUP_PATH_DOCUMENTS=/var/www/imperiopro/storage/backups/documents/
BACKUP_PATH_EXPORTS=/var/www/imperiopro/storage/backups/exports/

# Configuración de Retención (Días que se conservan los archivos antes de purgarse)
BACKUP_RETENTION_DAYS=30

# Opciones de Compresión y Seguridad
BACKUP_COMPRESSION_ENABLED=true
BACKUP_ENCRYPTION_KEY=

# Variables del Web Worker en Segundo Plano y Google Drive (Client-side)
VITE_BACKUP_STORAGE_THRESHOLD_PERCENT=85
VITE_AUTO_BACKUP_INTERVAL_MINUTES=60
VITE_ENABLE_CLOUD_BACKUP=true
VITE_GOOGLE_DRIVE_FOLDER_NAME=ImperioPro_Backups

# ==========================================
# PASARELA DE PAGOS - PAGUELOFACIL (PANAMÁ)
# ==========================================
# Backend / Server-side variables
# CCL: Clave de Cliente / Identificador de Comercio otorgado por PagueloFacil
PAGUELOFACIL_CCL=

# API_KEY / Token de Autenticación de PagueloFacil
PAGUELOFACIL_API_KEY=

# Entorno de ejecución: 'sandbox' para pruebas o 'production' para cobros reales
PAGUELOFACIL_ENV=sandbox

# URL de retorno / Webhook de confirmación para recepción de notificaciones de pago
PAGUELOFACIL_WEBHOOK_URL=

# Client-side (Vite) variables opcionales
VITE_PAGUELOFACIL_CCL=
VITE_PAGUELOFACIL_API_KEY=
VITE_PAGUELOFACIL_ENV=sandbox
VITE_PAGUELOFACIL_WEBHOOK_URL=

